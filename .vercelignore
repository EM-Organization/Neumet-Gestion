# Vercel construye con `npm ci && npm run build` y sirve solo dist/ (ver vercel.json).
# El build necesita: package.json, package-lock.json, scripts/build.mjs, index.html,
# adminpanel/, assets/, app-demo.mp4, src/ y vite.config.mjs (estos dos sí se suben: son el front nuevo). Lo demás no se sube a Vercel (la garantía de
# que no se publica nada más es outputDirectory + tests/build/verificar-dist.mjs).
docs/
supabase/
# tests/ no se sube, salvo tests/build/ (verificar-dist.mjs corre al final de scripts/build.mjs, docs/19 §7.1.1 d).
tests/*
!tests/build/
.github/
.claude/
node_modules/
eslint.config.js
.gitleaks.toml
.gitignore
README.md
SECURITY.md
